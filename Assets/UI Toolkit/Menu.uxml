    <ui:VisualElement name="Menu" style="flex-grow: 1; flex-direction: row;">
        <ui:VisualElement name="Left" style="flex-grow: 1; width: 0; height: 100%; margin-left: 0; -unity-background-image-tint-color: rgb(255, 255, 255); background-color: rgba(0, 0, 0, 0.255); flex-direction: row-reverse; margin-right: 199px; flex-shrink: 1; align-content: flex-start; justify-content: space-between; align-items: center; align-self: flex-start; position: relative; right: 0; min-width: auto;">
            <ui:VisualElement name="Buttons" style="flex-grow: 1; justify-content: center;">
