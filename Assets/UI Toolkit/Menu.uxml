            <ui:Label text="Little By Little" name="Titel" style="position: absolute; top: 78px; left: 141px; height: 187px; width: 576px; background-color: rgba(0, 0, 0, 0); font-size: 72px; color: rgb(255, 255, 255); -unity-text-align: middle-center; -unity-font-definition: url(&quot;project://database/Assets/yoster.ttf?fileID=12800000&amp;guid=b0c5bd3522f5183569010910544e0a3b&amp;type=3#yoster&quot;);"/>
        </ui:VisualElement>
        <ui:VisualElement name="Right" style="flex-grow: 1; flex-direction: row;">
